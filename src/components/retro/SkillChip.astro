---
interface Props { name: string; }
const { name } = Astro.props;
---
<span class="skill-chip">{name}</span>
<style>
  .skill-chip { display: inline-block; border: 1px solid var(--color-border); background: var(--color-badge-bg); color: var(--color-badge-text); padding: 0.12rem 0.6rem; font-size: 1.05rem; line-height: 1.5; }
</style>

---
interface Props { name: string; }
const { name } = Astro.props;
---

<figure class="pixel-desk" data-pixel-desk data-paused="true" data-lamp="on" data-building="false" data-complete="false">
  <button class="scene-trigger" type="button" data-run disabled aria-label={`Ejecutar demo en el escritorio pixel art de ${name}`}>
    <svg class="desk-art" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 280 184" width="560" height="368" fill="none" shape-rendering="crispEdges" role="img" aria-label={`${name}, con cabello oscuro y camiseta clara, sentado en su escritorio tecleando frente a una computadora.`}>
      <!-- Habitación y ventana: la misma noche azul del resto del portafolio. -->

        <path fill="#373039" d="M99 59h15v3h-11v4h-8v-3h4z" />
        <path fill="#211f25" d="M118 76h5v2h-5z" />
        <path class="eye" fill="#211f25" d="M120 79h2v3h-2z" />
        <path fill="#8b543f" d="M120 89h5v2h-5zm-19-9h3v7h-3z" />
      </g>
      <!-- Torre, monitor, teclado y ratón sobre el escritorio. -->
      <path fill="#050816" d="M232 99h22v36h-22z" />
      <path fill="#1f2f5c" d="M235 102h16v31h-16z" />
      <path fill="#3366ff" d="M238 108h10v2h-10zm0 5h10v2h-10z" />
      <path class="pc-led" fill="#3cff8b" d="M244 125h3v3h-3z" />
      <path class="monitor-glow" fill="#3366ff" fill-opacity=".07" d="M152 61h77v65h-77z" />
      <path fill="#52678f" d="M185 117h6v13h-6zm-11 13h28v3h-28z" />
      <path fill="#050816" d="M151 64h76v55h-76z" />
      <path fill="#354d7a" d="M154 67h70v48h-70z" />
      <path fill="#080f26" d="M157 70h64v41h-64z" />
      <path fill="#182951" d="M157 70h64v6h-64zm0 6h8v35h-8z" />
      <path fill="#ff6b6b" d="M160 72h2v2h-2z" />
      <path fill="#f7c948" d="M164 72h2v2h-2z" />
      <path fill="#3cff8b" d="M168 72h2v2h-2z" />
      <g class="editor-lines">
        <path fill="#5f8cff" d="M169 81h12v2h-12zm16 0h20v2h-20z" />
        <path fill="#ff5fd7" d="M173 86h16v2h-16z" />
        <path fill="#dbe4ff" d="M192 86h16v2h-16z" />
        <path class="code-line line-one" fill="#3cff8b" d="M177 91h32v2h-32z" />
        <path class="code-line line-two" fill="#f7c948" d="M177 96h23v2h-23z" />
        <path fill="#ff5fd7" d="M173 101h7v2h-7z" />
        <path class="screen-cursor" fill="#dbe4ff" d="M184 101h3v3h-3z" />
      </g>
      <g class="build-screen">
        <path fill="#5f8cff" d="M170 85h37v3h-37z" />
        <path class="build-progress" fill="#3cff8b" d="M170 93h37v4h-37z" />
        <text x="188" y="106" text-anchor="middle" fill="#8ea0d8">building...</text>
      </g>
      <g class="complete-screen">
        <path stroke="#3cff8b" stroke-width="3" d="m182 86 4 4 9-10" />
        <text x="189" y="104" text-anchor="middle" fill="#3cff8b">BUILD OK</text>
      </g>
      <path fill="#8ea0d8" d="M186 116h4v1h-4z" />
      <path fill="#1f2f5c" d="M123 130h47v3h4v4h-56v-4h5z" />
      <path fill="#52678f" d="M125 131h43v2h-43zm-3 3h48v1h-48z" />
      <path fill="#8ea0d8" d="M126 131h2v1h-2zm6 0h2v1h-2zm6 0h2v1h-2zm6 0h2v1h-2zm6 0h2v1h-2zm6 0h2v1h-2zm6 0h2v1h-2z" />
      <path class="key-light" fill="#5f8cff" d="M132 134h5v1h-5zm16-3h4v1h-4zm12 3h4v1h-4z" />
      <path fill="#52678f" d="M187 130h7v2h3v5h-13v-5h3z" />
      <path fill="#8ea0d8" d="M190 131h1v3h-1z" />
      <!-- Brazos con dos ritmos opuestos: el gesto de teclear queda siempre visible. -->
      <g class="typing-hand hand-back">
        <path fill="#bac9e2" d="M118 110h9v13h-9z" />
        <path fill="#b97852" d="M122 122h7v4h15v5h-22z" />
        <path fill="#d89b6e" d="M137 125h9v3h3v3h-12z" />
      </g>
      <g class="typing-hand hand-front">
        <path fill="#edf2ff" d="M105 112h12v12h-12z" />
        <path fill="#d89b6e" d="M109 123h8v6h14v5h-20v-3h-2z" />
        <path fill="#e5ae80" d="M129 128h9v3h4v3h-13z" />
      </g>
      <!-- Taza, vapor y borde rojo del escritorio. -->
      <path fill="#050816" d="M55 135h23v2H55z" />
      <path fill="#dbe4ff" d="M57 123h13v12H57zm13 2h5v7h-5v-2h3v-3h-3z" />
      <path fill="#8b543f" d="M59 123h9v2h-9z" />
      <path fill="#ff3c3c" d="M60 128h5v4h-5z" />
      <g class="coffee-steam" stroke="#8ea0d8" stroke-width="1" opacity=".5"><path d="M61 120v-4h2v-4m4 8v-5h2v-3" /></g>
      <path fill="#354d7a" d="M29 137h227v5H29z" />
      <path fill="#182951" d="M33 142h219v5H33z" />
      <path fill="#ff3c3c" d="M33 142h219v1H33z" />
      <path fill="#263c6b" d="M38 147h7v24h-7zm198 0h7v24h-7z" />
      <path fill="#050816" d="M42 147h3v24h-3zm198 0h3v24h-3z" />
      <text class="room-label" x="254" y="13" text-anchor="end" fill="#52678f">FRANCO'S WORKSPACE</text>
    </svg>
    <span class="scene-invitation" aria-hidden="true"><span>↵</span> CLIC PARA EJECUTAR</span>
  </button>
  <figcaption class="desk-toolbar">
    <span class="desk-status" role="status" aria-live="polite" aria-atomic="true" data-status>En el escritorio</span>
    <div class="desk-controls">
      <button type="button" data-toggle-motion aria-pressed="false" aria-label="Pausar animación del escritorio"><span data-motion-icon aria-hidden="true">Ⅱ</span><span data-motion-label>Pausar</span></button>
      <button type="button" data-toggle-lamp aria-pressed="true" aria-label="Luz del escritorio"><span class="lamp-indicator" aria-hidden="true"></span>Luz</button>
    </div>
  </figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-pixel-desk]').forEach(desk => {
    const run = desk.querySelector<HTMLButtonElement>('[data-run]');
    const motion = desk.querySelector<HTMLButtonElement>('[data-toggle-motion]');
    const lamp = desk.querySelector<HTMLButtonElement>('[data-toggle-lamp]');
    const status = desk.querySelector<HTMLElement>('[data-status]');
    const motionLabel = desk.querySelector<HTMLElement>('[data-motion-label]');
    const motionIcon = desk.querySelector<HTMLElement>('[data-motion-icon]');
    if (!run || !motion || !lamp || !status || !motionLabel || !motionIcon) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let paused = false;
    let building = false;
    let resetTimer: ReturnType<typeof setTimeout> | undefined;

    const updateMotion = () => {
      const reduced = reducedMotion.matches;
      desk.dataset.paused = String(paused || reduced);
      motion.disabled = reduced;
      motion.setAttribute('aria-pressed', String(paused || reduced));
      motion.setAttribute('aria-label', reduced ? 'Animación desactivada por movimiento reducido' : paused ? 'Reanudar animación del escritorio' : 'Pausar animación del escritorio');
      motionLabel.textContent = reduced ? 'Sin movimiento' : paused ? 'Reanudar' : 'Pausar';
      motionIcon.textContent = paused || reduced ? '▶' : 'Ⅱ';
      if (!building && desk.dataset.complete !== 'true') {
        status.textContent = reduced ? 'Modo sin movimiento' : paused ? 'En pausa. Un respiro.' : 'Escribiendo código…';
      }
    };

    run.disabled = false;
    updateMotion();
    desk.classList.add('is-ready');
    reducedMotion.addEventListener('change', updateMotion);

    motion.addEventListener('click', () => {
      paused = !paused;
      updateMotion();
    });
    lamp.addEventListener('click', () => {
      const on = desk.dataset.lamp !== 'on';
      desk.dataset.lamp = on ? 'on' : 'off';
      lamp.setAttribute('aria-pressed', String(on));
    });
    run.addEventListener('click', () => {
      if (building) return;
      clearTimeout(resetTimer);
      building = true;
      desk.dataset.building = 'true';
      desk.dataset.complete = 'false';
      run.setAttribute('aria-disabled', 'true');
      status.textContent = 'Compilando la demo…';
      setTimeout(() => {
        building = false;
        desk.dataset.building = 'false';
        desk.dataset.complete = 'true';
        run.removeAttribute('aria-disabled');
        status.textContent = '¡Build listo! Sin errores.';
        resetTimer = setTimeout(() => {
          desk.dataset.complete = 'false';
          updateMotion();
        }, 3000);
      }, 1600);
    });

  });
</script>

<style>
  .pixel-desk { --typing-speed: 420ms; margin: 0; background: #0d1630; }
  .scene-trigger { position: relative; display: block; width: 100%; padding: 0; border: 0; border-radius: 0; background: transparent; text-align: left; color: var(--color-text-base); cursor: pointer; touch-action: manipulation; }
  .scene-trigger:disabled { cursor: default; }
  .scene-trigger[aria-disabled='true'] { cursor: progress; }
  .scene-trigger:focus-visible { outline-offset: -4px; }
  .desk-art { display: block; width: 100%; height: auto; image-rendering: pixelated; }
  .desk-art text { font-family: var(--font-body); font-size: 6px; }
  .desk-art .room-label { font-size: 5px; letter-spacing: 0.8px; }
  .scene-invitation { position: absolute; bottom: 7px; left: 50%; transform: translateX(-50%); display: none; align-items: center; gap: 0.5rem; padding: 0.1rem 0.5rem; background: #050816e6; border: 1px solid #1f2f5c; color: #8ea0d8; font-size: 0.75rem; white-space: nowrap; pointer-events: none; }
  .scene-invitation > span { color: var(--color-gold); }
  .is-ready .scene-invitation { display: flex; }
  .scene-trigger:hover .scene-invitation, .scene-trigger:focus-visible .scene-invitation { border-color: var(--color-blue-light); color: var(--color-text-heading); }
  .desk-toolbar { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.3rem 0.75rem; padding: 0.45rem 0.8rem; border-top: 1px solid var(--color-border); background: var(--color-bg-secondary); }
  .desk-status { font-size: 0.95rem; color: var(--color-text-muted); }
  .desk-controls { display: none; gap: 0.4rem; }
  .is-ready .desk-controls { display: flex; }
  .desk-controls button { display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; min-height: 36px; padding: 0.15rem 0.5rem; border: 1px solid var(--color-border); background: var(--color-panel); color: var(--color-text-base); font-size: 0.9rem; cursor: pointer; }
  .desk-controls button:hover:not(:disabled) { border-color: var(--color-blue-light); }
  .desk-controls button:disabled { color: var(--color-text-muted); cursor: default; }
  [data-motion-icon] { font-size: 0.7rem; color: var(--color-blue-light); }
  .lamp-indicator { width: 5px; height: 5px; background: var(--color-gold); }
  [data-lamp='off'] .lamp-light { opacity: 0; }
  [data-lamp='off'] .lamp-indicator { background: var(--color-text-muted); }
  .typing-hand { animation: type-key var(--typing-speed) steps(2, end) infinite; }
  .hand-back { animation-delay: -210ms; }
  .developer { animation: developer-breathe 4s steps(2, end) infinite; }
  .eye { animation: eye-blink 6s steps(1, end) infinite; }
  .code-line { transform-box: fill-box; transform-origin: left; animation: write-code 3.6s steps(8, end) infinite; }
  .line-two { animation-delay: -1.8s; }
  .screen-cursor { animation: cursor-blink 1s steps(1, end) infinite; }
  .key-light { animation: cursor-blink 600ms steps(1, end) infinite; }
  .coffee-steam { animation: steam-rise 3s steps(3, end) infinite; }
  .build-screen, .complete-screen { display: none; }
  [data-building='true'] { --typing-speed: 160ms; }
  [data-building='true'] .editor-lines, [data-complete='true'] .editor-lines { display: none; }
  [data-building='true'] .build-screen, [data-complete='true'] .complete-screen { display: block; }
  [data-building='true'] .monitor-glow { fill-opacity: 0.16; }
  [data-building='true'] .desk-status { color: var(--color-gold); }
  [data-complete='true'] .desk-status { color: var(--color-green); }
  .build-progress { transform-box: fill-box; transform-origin: left; }
  [data-building='true'] .build-progress { animation: build-code 1.5s steps(10, end) both; }
  [data-paused='true'] *, [data-paused='true'] *::before, [data-paused='true'] *::after { animation-play-state: paused !important; }
  @keyframes type-key { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(2px); } }
  @keyframes developer-breathe { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(1px); } }
  @keyframes eye-blink { 0%, 94%, 98%, 100% { opacity: 1; } 95%, 97% { opacity: 0; } }
  @keyframes write-code { 0%, 10% { transform: scaleX(0.15); } 65%, 100% { transform: scaleX(1); } }
  @keyframes cursor-blink { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }
  @keyframes steam-rise { 0% { transform: translateY(1px); opacity: 0; } 35%, 65% { opacity: 0.45; } 100% { transform: translateY(-4px); opacity: 0; } }
  @keyframes build-code { from { transform: scaleX(0.05); } to { transform: scaleX(1); } }
  @media (prefers-reduced-motion: reduce) { .pixel-desk *, .pixel-desk *::before, .pixel-desk *::after { animation: none !important; transition: none !important; } }
  @media print { .pixel-desk { display: none; } }
</style>

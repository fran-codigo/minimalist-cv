        <path fill="#8b543f" d="M106 94h12v5h-12z" />
        <path fill="#bac9e2" d="M96 103h10v3h12v-3h7v5h5v28h-4v12H92v-29h-2v-11h6z" />
        <path fill="#edf2ff" d="M98 103h8v6h12v-6h6v8h-5v27H97v-24h-4v-6h5z" />
        <path fill="#8ea0b8" d="M92 123h6v18h25v7H92z" />

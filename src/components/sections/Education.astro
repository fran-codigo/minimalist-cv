---
import RetroPanel from '@/components/retro/RetroPanel.astro';
import { education } from '@cv';
---
<RetroPanel title="Academy" id="educacion" index="06" label="EDUCACIÓN">
  <ul>
    {education.map(({ institution, area, startDate, endDate }) => <li>
      <article>
        <p class="dates">{startDate.slice(0, 4)} — {endDate ? endDate.slice(0, 4) : 'Actual'}</p>
        <h3>{institution}</h3>
        <p class="area">{area}</p>
      </article>
    </li>)}
  </ul>
</RetroPanel>
<style>
  ul { display: grid; gap: 1.5rem; }
  .dates { color: var(--color-gold); font-size: 1.1rem; margin-bottom: 0.75rem; }
  h3 { font-size: 1.5rem; line-height: 1.35; }
  .area { color: var(--color-text-muted); font-size: 1.2rem; margin-top: 0.75rem; }
</style>

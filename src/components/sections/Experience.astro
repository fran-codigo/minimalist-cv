---
import RetroPanel from '@/components/retro/RetroPanel.astro';
import { work } from '@cv';
---
<RetroPanel title="Bitácora de misiones" id="experiencia" index="03" label="EXPERIENCE.log">
  <ol class="timeline">
    {work.map(({ name, startDate, endDate, position, summary, highlights }, index) => (
      <li class:list={['mission', { current: !endDate }]}>
        <article>
          <header>
            <p class="mission-id">MISIÓN {String(work.length - index).padStart(2, '0')} <span aria-hidden="true">/</span> <span>{startDate.slice(0, 4)} — {endDate ? endDate.slice(0, 4) : 'Actual'}</span></p>
            <h3>{name}</h3>
            <p class="position">{position}</p>
          </header>
          <p class="summary">{summary}</p>
          <ul class="highlights">{highlights.map(highlight => <li>{highlight}</li>)}</ul>
        </article>
      </li>
    ))}
  </ol>
</RetroPanel>
<style>
  .timeline { list-style: none; padding: 0; margin: 0 0 0 5px; border-left: 1px solid var(--color-border); }
  .mission { position: relative; padding: 0 0 2rem 1.75rem; }
  .mission:last-child { padding-bottom: 0; }
  .mission::before { content: ''; position: absolute; left: -5px; top: 7px; width: 9px; height: 9px; background: var(--color-text-muted); border: 2px solid var(--color-bg-secondary); }
  .current::before { background: var(--color-red); box-shadow: 0 0 0 3px #ff3c3c20; }
  .mission-id { color: var(--color-text-muted); font-size: 1rem; margin-bottom: 0.4rem; }
  .mission-id > span:first-child { margin: 0 0.5rem; color: var(--color-border-hover); }
  .current .mission-id > span:last-child { color: var(--color-gold); }
  h3 { font-size: 1.6rem; line-height: 1.25; }
  .position { color: var(--color-blue-light); font-size: 1.2rem; margin-top: 0.25rem; }
  .summary { margin: 1rem 0 0.75rem; font-size: 1.2rem; }
  .highlights { list-style: square; padding-left: 1rem; color: var(--color-text-muted); font-size: 1.15rem; }
  .highlights li { margin-top: 0.4rem; padding-left: 0.2rem; }
  .highlights li::marker { color: var(--color-blue-light); font-size: 0.8rem; }
  @media (width <= 560px) { .mission { padding-left: 1rem; } }
  @media print { .mission { break-inside: avoid; } }
</style>

---
import { basics, projects, skills } from '@cv';
import PixelButton from '@/components/retro/PixelButton.astro';
import PixelDesk from '@/components/retro/PixelDesk.astro';
import Mail from '@/icons/Mail.astro';
import Linkedin from '@/icons/Linkedin.astro';
import GitHub from '@/icons/GitHub.astro';
import WorldMap from '@/icons/WorldMap.astro';

const { name, label, location, profiles, email } = basics;
const SOCIAL_ICONS: Record<string, typeof GitHub> = { GitHub, Linkedin };
const printInfo = [email, ...profiles.map(({ url }) => url)].join(' • ');
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow"><span class="cursor" aria-hidden="true">&gt;</span> PORTAFOLIO / FULL-STACK DEVELOPER</p>
    <h1 id="hero-title">{name.split(' ')[0]}<br /><span>{name.split(' ').slice(1).join(' ')}<span class="period">.</span></span></h1>
    <p class="role">{label}<span class="role-line" aria-hidden="true"></span></p>
    <p class="intro">Aplicaciones web claras, mantenibles y listas para crecer.</p>
    <p class="location"><WorldMap /> {location.city}, {location.region}</p>
    <div class="hero-actions no-print">
      <PixelButton href="#proyectos"><span aria-hidden="true">▶</span> Explorar proyectos</PixelButton>
      <PixelButton href={`mailto:${email}`} variant="secondary">Hablemos <span aria-hidden="true">↗</span></PixelButton>
    </div>
    <ul class="social-links no-print" aria-label="Contacto y redes sociales">
      <li><a href={`mailto:${email}`} aria-label={`Enviar correo a ${name}`} title={email}><Mail /></a></li>
      {profiles.map(({ network, url }) => {
        const Icon = SOCIAL_ICONS[network];
        return <li><a href={url} target="_blank" rel="noopener noreferrer" aria-label={`Visitar ${network} de ${name}`}>{Icon ? <Icon /> : network}</a></li>;
      })}
      <li class="social-caption" aria-hidden="true">ENCUÉNTRAME EN LA RED</li>
    </ul>
    <p class="print">{printInfo}</p>
  </div>
  <div class="character-panel">
    <div class="character-top"><span>PLAYER_01</span><span class="character-symbols" aria-hidden="true">+ + +</span></div>
    <PixelDesk name={name} />
    <div class="character-info"><span>{name}</span><span class="class-label">{label}</span></div>
    <dl class="character-stats">
      <div><dt>PROYECTOS</dt><dd>{String(projects.length).padStart(2, '0')}</dd></div>
      <div><dt>TECNOLOGÍAS</dt><dd>{String(skills.length).padStart(2, '0')}</dd></div>
      <div><dt>BASE</dt><dd>{location.countryCode}</dd></div>
    </dl>
    <div class="character-bottom" aria-hidden="true"><span class="segments"></span><span>CREAR · APRENDER · REPETIR</span></div>
  </div>
</section>
<style>
  .hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr); gap: 1.5rem; align-items: center; max-width: 960px; margin-inline: auto; padding: 1.5rem 0 1.75rem; }
  .eyebrow { margin-bottom: 0.65rem; }
  .cursor { color: var(--color-red-light); margin-right: 0.5rem; }
  h1 { font-size: clamp(2rem, 4.3vw, 3.15rem); line-height: 1.2; letter-spacing: -0.055em; }
  h1 > span { color: var(--color-blue-light); }
  .period { color: var(--color-red); }
  .role { display: flex; align-items: center; gap: 0.85rem; margin-top: 0.5rem; color: var(--color-gold); font-size: 1.5rem; line-height: 1.3; }
  .role-line { width: 44px; height: 2px; background: var(--color-border); }
  .intro { max-width: 34ch; margin: 0.35rem 0; color: var(--color-text-muted); font-size: 1.4rem; line-height: 1.4; }
  .location { display: flex; align-items: center; gap: 0.5rem; color: var(--color-text-muted); font-size: 1.1rem; }
  .location :global(svg) { width: 16px; height: 16px; }
  .hero-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; margin: 0.9rem 0; }
  .social-links { display: flex; gap: 0.5rem; align-items: center; }
  .social-links a { display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; border: 1px solid var(--color-border); color: var(--color-text-muted); transition: color 150ms, border-color 150ms, transform 150ms; }
  .social-links a:hover { color: var(--color-blue-light); border-color: var(--color-blue-light); transform: translateY(-2px); }
  .social-links :global(svg) { width: 17px; height: 17px; }
  .social-caption { margin-left: 0.7rem; color: var(--color-text-muted); font-size: 0.8rem; letter-spacing: 0.05em; }
  .character-panel { position: relative; width: 100%; max-width: 400px; justify-self: start; border: 2px solid var(--color-border); background: var(--color-bg-secondary); box-shadow: 7px 7px 0 #02040d, 0 0 60px #3366ff0d; }
  .character-panel::before, .character-panel::after { content: ''; position: absolute; width: 9px; height: 9px; background: var(--color-blue-light); z-index: 1; }
  .character-panel::before { top: -2px; left: -2px; }
  .character-panel::after { bottom: -2px; right: -2px; background: var(--color-red); }
  .character-top { display: flex; justify-content: space-between; padding: 0.5rem 0.85rem; border-bottom: 1px solid var(--color-border); font-size: 0.85rem; color: var(--color-text-muted); }
  .character-symbols { color: var(--color-blue-light); }
  .character-info { display: flex; align-items: baseline; justify-content: space-between; gap: 0.6rem; padding: 0.75rem 0.85rem 0.35rem; border-top: 1px solid var(--color-border); }
  .character-info > span:first-child { font-size: 1.35rem; }
  .class-label { color: var(--color-text-muted); font-size: 0.95rem; }
  .character-stats { display: grid; grid-template-columns: repeat(3, 1fr); margin: 0.3rem 0.85rem 0.75rem; padding: 0; }
  .character-stats div { text-align: center; border-right: 1px solid var(--color-border); }
  .character-stats div:last-child { border: none; }
  dt { font-size: 0.75rem; color: var(--color-text-muted); }
  dd { margin: 0; color: var(--color-gold); font-size: 1.45rem; }
  .character-bottom { border-top: 1px solid var(--color-border); padding: 0.45rem 0.85rem; display: flex; align-items: center; gap: 0.85rem; font-size: 0.72rem; color: var(--color-text-muted); }
  .segments { width: 44px; height: 6px; background: repeating-linear-gradient(90deg, var(--color-blue) 0 5px, transparent 5px 8px); }
  @media (width <= 850px) { .hero { gap: 1.25rem; } .social-caption { display: none; } .class-label { font-size: 0.85rem; } }
  @media (width <= 680px) { .hero { grid-template-columns: 1fr; padding: 1.25rem 0 1.5rem; gap: 1rem; } h1 { font-size: clamp(2rem, 9vw, 3rem); } .character-panel { max-width: 340px; width: 100%; justify-self: center; } .hero-actions { gap: 0.75rem; } }
  @media (width <= 360px) { .eyebrow { font-size: 0.47rem; } }
  @media print { .hero { padding: 1rem 0; display: block; } h1 { font-size: 1.4rem; } .character-panel { display: none; } .intro { max-width: none; } .print { overflow-wrap: anywhere; } }
</style>

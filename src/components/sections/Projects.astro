---
import { projects } from '@cv';
import CoverMedia from '@/components/retro/CoverMedia.astro';
import PixelButton from '@/components/retro/PixelButton.astro';
import SkillChip from '@/components/retro/SkillChip.astro';
import StatusBadge from '@/components/retro/StatusBadge.astro';

const topProjects = projects.filter(project => project.isFeatured).slice(0, 4);
---
<section id="proyectos" class="projects reveal" aria-labelledby="projects-title">
  <header class="section-heading">
    <div><p class="eyebrow">02 / SELECCIÓN DE PROYECTOS</p><h2 id="projects-title">Misiones destacadas<span aria-hidden="true">_</span></h2></div>
    <span class="project-count" aria-label={`${topProjects.length} proyectos destacados`}>{String(topProjects.length).padStart(2, '0')} EN EL MAPA</span>
  </header>
  <ul class="project-grid">
    {topProjects.map(({ name, image, description, highlights, isActive, url, description_url }, index) => (
      <li>
        <article class="project-card">
          <div class="card-top"><span class="project-index">PROJECT_{String(index + 1).padStart(2, '0')}</span><StatusBadge status={isActive ? 'active' : 'archived'} /></div>
          {description_url ? <a href={description_url} class="cover-link" aria-label={`Ver detalle de ${name}`}><CoverMedia image={image} name={name} /></a> : <CoverMedia image={image} name={name} />}
          <div class="card-body">
            <div class="project-heading"><h3>{name}</h3><span class="star" aria-label="Destacado">✦</span></div>
            <p>{description}</p>
            <ul class="project-stack" aria-label={`Tecnologías de ${name}`}>{highlights.flatMap(highlight => highlight.split(',').map(item => item.trim()).filter(Boolean)).map(name => <li><SkillChip name={name} /></li>)}</ul>
            <div class="project-actions no-print">
              {description_url && <a href={description_url}>Ver detalle <span aria-hidden="true">→</span></a>}
              {url && <a href={url} target="_blank" rel="noopener noreferrer" aria-label={`Abrir sitio de ${name} en otra pestaña`}>Sitio web <span aria-hidden="true">↗</span></a>}
            </div>
          </div>
        </article>
      </li>
    ))}
  </ul>
  <div class="all-projects no-print"><span class="archive-label">LA AVENTURA CONTINÚA</span><PixelButton href="/proyectos" variant="secondary">Ver todos los proyectos <span aria-hidden="true">→</span></PixelButton></div>
</section>
<style>
  .projects { margin-block: 3.5rem; }
  .section-heading { display: flex; justify-content: space-between; align-items: flex-end; gap: 1rem; margin-bottom: 1.5rem; }
  .eyebrow { margin-bottom: 0.8rem; }
  h2 { font-size: clamp(0.7rem, 1.6vw, 1rem); }
  h2 span { color: var(--color-red); margin-left: 0.4rem; }
  .project-count { white-space: nowrap; color: var(--color-text-muted); font-size: 0.95rem; }
  .project-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
  .project-card { display: flex; flex-direction: column; height: 100%; min-width: 0; background: var(--color-bg-secondary); border: 1px solid var(--color-border); box-shadow: var(--shadow-pixel); transition: transform 180ms, border-color 180ms, box-shadow 180ms; }
  .project-card:hover { transform: translateY(-2px); border-color: var(--color-blue-light); box-shadow: 5px 7px 0 #02040d, 0 0 22px #3366ff12; }
  .project-grid > li:nth-child(even) .project-card:hover { border-color: var(--color-red-light); }
  .card-top { display: flex; align-items: center; justify-content: space-between; padding: 0.55rem 0.9rem; border-bottom: 1px solid var(--color-border); }
  .project-index { font-size: 0.9rem; color: var(--color-text-muted); }
  .cover-link { display: block; }
  .card-body { padding: 1.4rem; display: flex; flex-direction: column; flex: 1; }
  .project-heading { display: flex; justify-content: space-between; gap: 0.75rem; align-items: baseline; margin-bottom: 0.7rem; }
  h3 { font-size: 1.7rem; line-height: 1.2; }
  .star { color: var(--color-gold); font-size: 1rem; }
  .card-body > p { font-size: 1.2rem; line-height: 1.5; color: var(--color-text-muted); }
  .project-stack { display: flex; flex-wrap: wrap; gap: 0.35rem; margin: 1.2rem 0; }
  .project-actions { border-top: 1px solid var(--color-border); padding-top: 0.9rem; margin-top: auto; display: flex; justify-content: space-between; gap: 1rem; font-size: 1.2rem; }
  .project-actions a { display: inline-flex; align-items: center; gap: 0.75rem; min-height: 36px; }
  .project-actions a:first-child { color: var(--color-text-base); }
  .project-actions a:hover { color: var(--color-red-light); }
  .all-projects { display: flex; align-items: center; justify-content: center; gap: 1.5rem; margin-top: 2rem; padding: 1.5rem 0; border-block: 1px dashed var(--color-border); }
  .archive-label { font-size: 0.9rem; color: var(--color-text-muted); }
  @media (width <= 680px) { .project-grid { grid-template-columns: 1fr; } .projects { margin-block: 2.5rem; } .project-count, .archive-label { display: none; } .card-body { padding: 1.1rem; } }
  @media print { .projects { margin-block: 1rem; } .project-grid { gap: 0.8rem; } .project-card { break-inside: avoid; } .project-card :global(.cover-media) { display: none; } .card-body { padding: 0.6rem; } h3 { font-size: 14pt; } .card-body > p { font-size: 11pt; } }
</style>

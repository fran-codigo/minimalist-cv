---
import { basics } from '@cv';
const profilesInfo = basics.profiles.map(({ network, url }) => ({
  id: network,
  title: `Visitar ${network}`,
  section: 'Social',
  url,
}));
---
<div class="command-hint no-print">
  <button type="button" id="open-commands">Abrir comandos <span><kbd>Ctrl / ⌘</kbd> + <kbd>K</kbd></span></button>
</div>
<ninja-keys class="dark no-print" data-info={JSON.stringify(profilesInfo)} placeholder="Buscar comando…" hideBreadcrumbs noAutoLoadMdIcons></ninja-keys>
<script>
  import 'ninja-keys';
  const ninja = document.querySelector('ninja-keys');
  if (ninja) {
    const profiles: { id: string; title: string; section: string; url: string }[] = JSON.parse(ninja.getAttribute('data-info') ?? '[]');
    ninja.data = [
      { id: 'home', title: 'Ir al inicio', section: 'Navegación', handler: () => { window.location.assign('/'); } },
      { id: 'projects', title: 'Ver todos los proyectos', section: 'Navegación', handler: () => { window.location.assign('/proyectos'); } },
      { id: 'experience', title: 'Ver experiencia', section: 'Navegación', handler: () => { window.location.assign('/#experiencia'); } },
      { id: 'print', title: 'Imprimir / Guardar CV como PDF', section: 'Acciones', handler: () => { window.print(); } },
      ...profiles.map(profile => ({ ...profile, handler: () => { window.open(profile.url, '_blank', 'noopener,noreferrer'); } })),
    ];
    document.getElementById('open-commands')?.addEventListener('click', () => ninja.open());
  }
</script>
<style>
  .command-hint { text-align: center; padding: 0.5rem 1rem 2rem; }
  button { display: inline-flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 0.75rem; min-height: 44px; padding: 0.4rem; cursor: pointer; color: var(--color-text-muted); font-size: 1rem; background: transparent; border: 0; }
  button:hover { color: var(--color-text-heading); }
  kbd { font: inherit; border: 1px solid var(--color-border); padding: 0.1rem 0.35rem; background: var(--color-bg-secondary); }
  ninja-keys { --ninja-font-family: var(--font-body); --ninja-font-size: 22px; --ninja-text-color: var(--color-text-base); --ninja-modal-background: var(--color-bg-secondary); --ninja-accent-color: var(--color-blue-light); --ninja-secondary-background-color: var(--color-panel); --ninja-secondary-text-color: var(--color-text-muted); --ninja-selected-background: var(--color-panel); --ninja-selected-text-color: var(--color-text-heading); --ninja-group-text-color: var(--color-text-muted); --ninja-footer-background: var(--color-bg-secondary); --ninja-placeholder-color: var(--color-text-muted); --ninja-overflow-background: #02040ddd; --ninja-width: min(640px, calc(100vw - 2rem)); --ninja-top: 10%; --ninja-key-border-radius: 0; }
  ninja-keys::part(ninja-input):focus-visible { outline: 2px solid var(--color-gold); outline-offset: -3px; }
  @media (prefers-reduced-motion: reduce) { ninja-keys::part(actions-list) { scroll-behavior: auto; } }
</style>
